# Environment Variables Template
# Copy this to .env and fill in values

# Backend
PORT=8082
DATABASE_URL=postgres://pico:changeme@postgres:5432/pico?sslmode=disable
JWT_SECRET=change-me-in-production

# Storage
STORAGE_PATH=/data/photos
MAX_UPLOAD_BYTES=5242880
IMAGE_MAX_WIDTH=1200
IMAGE_QUALITY=70
THUMBNAIL_WIDTH=300

# Guest Access
GUEST_TOKEN_EXPIRY_DAYS=30

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Immich Integration (optional)
IMMICH_API_URL=
IMMICH_API_KEY=
IMMICH_DEVICE_ID=pico
IMMICH_ALBUM_ID=
